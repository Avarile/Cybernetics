# Application
NODE_ENV=development
PORT=3000
APP_NAME=cybernetics

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=cybernetics
DATABASE_SSL=false
DATABASE_LOGGING=false

# Redis (shared by cache, session cache, and BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Observability (Sentry)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Logging
LOG_LEVEL=info

# MinIO / object storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_BUCKET=cybernetics
MINIO_PRESIGN_EXPIRY=300          # presigned URL TTL (seconds)

# File policy
FILE_MAX_SIZE=52428800            # 50 MiB max upload
FILE_ALLOWED_MIME=                # csv allowlist; empty = allow any
FILE_PENDING_TTL=3600             # seconds before an unfinished upload is expired
