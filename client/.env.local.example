# The API origin. No path prefix — the NestJS app calls setGlobalPrefix nowhere.
# The API defaults to PORT=3000; the client dev server runs on 3100.
NEXT_PUBLIC_API_URL=http://localhost:3000

# POST /auth/register does not exist yet (users.controller.ts is admin-only
# provisioning). Leave false until the endpoint is built.
NEXT_PUBLIC_ENABLE_REGISTER=false
