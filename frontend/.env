# ── API ──────────────────────────────────────────────────────────────────────
# Base URL of the backend API, accessible from the browser.
# Must include protocol and port, no trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:9009

# Base URL used for server-side fetch calls (e.g. OAuth callback verification).
# Can be the same as NEXT_PUBLIC_API_URL in development.
API_URL=http://localhost:9009
